{
  "rules": {
    ".read": false,
    ".write": false,
    "adminWriteLock": {
      ".read": false,
      ".write": false
    },
    "adminAudit": {
      ".read": "auth != null && auth.token.admin === true",
      ".write": false
    },
    "promotions": {
      ".read": "(auth != null && auth.token.admin === true) || (query.orderByChild === 'active' && query.equalTo === true)",
      ".write": false,
      ".indexOn": ["active"],
      "$promotionId": {
        ".read": "data.child('active').val() === true"
      }
    },
    "scholarships": {
      ".read": "auth != null && auth.token.admin === true",
      ".write": false,
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },
    "cafeteria": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.admin === true",
      "location": {
        "latitude": {
          ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90"
        },
        "longitude": {
          ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180"
        }
      }
    },
    "categories": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.admin === true"
    },
    "products": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.admin === true",
      "$productId": {
        ".validate": "newData.hasChildren(['name', 'categoryId', 'available', 'prepMinutes']) && (newData.hasChild('variants') || newData.hasChild('priceCents'))",
        "priceCents": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() % 1 === 0"
        },
        "available": {
          ".validate": "newData.isBoolean()"
        },
        "prepMinutes": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 240"
        },
        "variants": {
          ".validate": "newData.hasChildren(['0'])",
          "$variantIndex": {
            ".validate": "($variantIndex === '0' || ($variantIndex === '1' && newData.parent().hasChildren(['0', '1'])) || ($variantIndex === '2' && newData.parent().hasChildren(['0', '1', '2'])) || ($variantIndex === '3' && newData.parent().hasChildren(['0', '1', '2', '3'])) || ($variantIndex === '4' && newData.parent().hasChildren(['0', '1', '2', '3', '4'])) || ($variantIndex === '5' && newData.parent().hasChildren(['0', '1', '2', '3', '4', '5']))) && newData.hasChildren(['label', 'priceCents'])",
            "label": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40"
            },
            "priceCents": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() % 1 === 0"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    },
    "profiles": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.staff === true)",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "ordersByUser": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "orders": {
      "$orderId": {
        ".read": "auth != null && (data.child('ownerUid').val() === auth.uid || auth.token.staff === true || auth.token.admin === true)",
        ".write": false,
        ".validate": "newData.hasChildren(['ownerUid', 'status', 'totalCents'])"
      }
    },
    "rejectionNotices": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "staffQueue": {
      ".read": "auth != null && (auth.token.staff === true || auth.token.admin === true)",
      ".write": false
    },
    "payments": {
      ".read": false,
      ".write": false
    },
    "pickupTokens": {
      ".read": false,
      ".write": false
    },
    "pickupSlots": {
      ".read": false,
      ".write": false
    },
    "plans": {
      ".read": "auth != null",
      ".write": false
    },
    "memberships": {
      ".read": false,
      ".write": false,
      "$uid": {
        ".write": false
      }
    },
    "pickupDeliveries": {
      ".read": false,
      ".write": false
    },
    "notificationPreferences": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "$topic": {
          ".validate": "($topic === 'cafeteria_menu' || $topic === 'cafeteria_ofertas' || $topic === 'cafeteria_consejos' || $topic === 'cafeteria_avisos' || $topic === 'consejos_cafeteria') && newData.isBoolean()"
        }
      }
    },
    "notificationTokens": {
      "$uid": {
        ".read": false,
        "$tokenHash": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['token', 'platform', 'updatedAt'])",
          "token": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 4096"
          },
          "platform": {
            ".validate": "newData.val() === 'android'"
          },
          "updatedAt": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "notificationInbox": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$notificationId": {
          ".validate": "newData.hasChildren(['type', 'title', 'body', 'createdAt', 'isRead'])",
          "type": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 64"
          },
          "title": {
            ".validate": "newData.isString() && newData.val().length <= 120"
          },
          "body": {
            ".validate": "newData.isString() && newData.val().length <= 500"
          },
          "orderId": {
            ".validate": "newData.isString() && newData.val().length <= 128"
          },
          "createdAt": {
            ".validate": "newData.isNumber()"
          },
          "isRead": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.isBoolean()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "deviceRegistrations": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "orderEvents": {
      "$orderId": {
        ".read": "auth != null && (auth.token.staff === true || auth.token.admin === true)",
        ".write": false
      }
    },
    "notificationTipDismissals": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "$tipId": {
          ".validate": "newData.isBoolean() && $tipId.length <= 32"
        }
      }
    }
  }
}
