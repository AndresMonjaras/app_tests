{
  "rules": {
    ".read": false,
    ".write": false,

    "cafeteria": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.staff === true"
    },

    "categories": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.admin === true"
    },

    "products": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.admin === true",
      "$productId": {
        ".validate": "newData.hasChildren(['name', 'categoryId', 'available', 'prepMinutes']) && (newData.hasChild('variants') || newData.hasChild('priceCents'))",
        "priceCents": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() % 1 === 0" },
        "prepMinutes": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 240" },
        "variants": {
          ".validate": "newData.hasChildren(['0'])",
          "$variantIndex": {
            ".validate": "($variantIndex === '0' || ($variantIndex === '1' && newData.parent().hasChildren(['0', '1'])) || ($variantIndex === '2' && newData.parent().hasChildren(['0', '1', '2'])) || ($variantIndex === '3' && newData.parent().hasChildren(['0', '1', '2', '3'])) || ($variantIndex === '4' && newData.parent().hasChildren(['0', '1', '2', '3', '4'])) || ($variantIndex === '5' && newData.parent().hasChildren(['0', '1', '2', '3', '4', '5']))) && newData.hasChildren(['label', 'priceCents'])",
            "label": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40" },
            "priceCents": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() % 1 === 0" },
            "$other": { ".validate": false }
          }
        }
      }
    },

    "profiles": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.staff === true)",
        "displayName": {
          ".write": "auth != null && auth.uid === $uid && auth.token.email_verified === true",
          ".validate": "newData.isString() && newData.val().length <= 80"
        },
        "avatarPath": {
          ".write": "auth != null && auth.uid === $uid && auth.token.email_verified === true && auth.token.avatar_editable === true",
          ".validate": "newData.isString() && newData.val().length <= 240 && newData.val().beginsWith('profiles/' + $uid + '/avatar/')"
        },
        "updatedAt": {
          ".write": "auth != null && auth.uid === $uid && auth.token.email_verified === true",
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".write": false,
          ".validate": false
        }
      }
    },

    "ordersByUser": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },

    "orders": {
      "$orderId": {
        ".read": "auth != null && (data.child('ownerUid').val() === auth.uid || auth.token.staff === true)",
        ".write": false,
        ".validate": "newData.hasChildren(['ownerUid', 'status', 'totalCents'])"
      }
    },

    "staffQueue": {
      ".read": "auth != null && auth.token.staff === true",
      ".write": false
    },

    "payments": {
      ".read": false,
      ".write": false
    },

    "pickupTokens": {
      ".read": false,
      ".write": false
    },

    "pickupSlots": {
      ".read": "auth != null",
      ".write": false
    },

    "plans": {
      ".read": "auth != null",
      ".write": false
    },

    "memberships": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },

    "notificationPreferences": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$topic": {
          ".write": "auth != null && auth.uid === $uid && auth.token.email_verified === true && ($topic === 'cafeteria_menu' || $topic === 'cafeteria_ofertas' || $topic === 'cafeteria_avisos')",
          ".validate": "newData.isBoolean()"
        }
      }
    },

    "deviceRegistrations": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$deviceId": {
          ".write": "auth != null && auth.uid === $uid && auth.token.email_verified === true",
          ".validate": "newData.hasChildren(['installationId', 'registeredAt'])",
          "installationId": { ".validate": "newData.isString() && newData.val().length <= 256" },
          "registeredAt": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        }
      }
    },

    "orderEvents": {
      "$orderId": {
        ".read": "auth != null && (root.child('orders').child($orderId).child('ownerUid').val() === auth.uid || auth.token.staff === true)",
        ".write": false
      }
    }
  }
}
